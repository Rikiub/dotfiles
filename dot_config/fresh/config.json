{
  "default_language": "bash",
  "theme": "dark",
  "version": 2,
  "lsp": {
    "json": {
      "enabled": true,
      "auto_start": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": true
      }
    },
    "python": {
      "enabled": true,
      "command": "ty",
      "args": ["server"],
      "auto_start": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": true
      }
    },
    "kdl": {
        "enabled": true,
        "command": "kdl-lsp",
        "auto_start": true,
        "process_limits": {
            "max_memory_percent": 50,
            "max_cpu_percent": 90,
            "enabled": true
        }
    },
    "nushell": {
      "enabled": true,
      "auto_start": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": true
      }
    }
  },
  "editor": {
    "use_tabs": true,
    "whitespace_tabs_trailing": false,
    "whitespace_tabs_leading": false
  }
}