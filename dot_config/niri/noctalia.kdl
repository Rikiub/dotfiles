layout {

    focus-ring {
        active-color   "#ffb2b8"
        inactive-color "#1e0f10"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb2b8"
        inactive-color "#1e0f10"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ffb2b8"
        inactive-color "#e32651"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb2b880"
    }
}

recent-windows {
    highlight {
        active-color "#ffb2b8"
        urgent-color "#ffb4ab"
    }
}
